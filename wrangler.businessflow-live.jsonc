{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "businessflow-live",
  "main": "./businessflow-standalone/src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./businessflow-standalone/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  }
}
