{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "tradeflow-test",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "TRADEFLOW_ENV": "test",
    "TEST_SUPABASE_URL": "https://nnsshnfkjcflucjrftzi.supabase.co",
    "TEST_SUPABASE_KEY": "REPLACE_WITH_NEW_TEST_SUPABASE_PUBLISHABLE_KEY",
    "LIVE_SUPABASE_URL": "https://gxsrajtqzdjvmceqcpgv.supabase.co",
    "LIVE_SUPABASE_KEY": "REPLACE_WITH_LIVE_SUPABASE_PUBLISHABLE_KEY"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*.js"
    ]
  }
}
